@page "/run/{RunId:guid}/result"
@inject RankingService RankingService
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> Localizer

<PageTitle>@Localizer["AppTitle"] – @Localizer["ResultHeading"]</PageTitle>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}

@if (_result is null)
{
    <MudText>@Localizer["LoadingText"]</MudText>
}
else
{
    <MudText Typo="Typo.h4" Class="mb-4">@Localizer["ResultHeading"]</MudText>

    @if (!_finished)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            @Localizer["NotFinishedNotice"]
            <MudButton Class="ml-2" Size="Size.Small" OnClick="@(() => Navigation.NavigateTo($"run/{RunId}"))">@Localizer["ContinueButton"]</MudButton>
        </MudAlert>
    }

    <MudGrid Class="mb-6">
        @foreach (var entry in _result.Ranking.Take(3))
        {
            <MudItem xs="12" sm="4">
                <MudPaper Class="pa-6" Style="@($"border-top: 6px solid {MedalColor(entry.Rank)}")" Elevation="4">
                    <MudText Typo="Typo.h3" Style="@($"color:{MedalColor(entry.Rank)}")">#@entry.Rank</MudText>
                    <MudText Typo="Typo.h5">@entry.Name</MudText>
                    <MudText Typo="Typo.caption">@Localizer["ComparisonsCountFormat", entry.ComparisonCount]</MudText>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    @if (_result.Ranking.Count > 3)
    {
        <MudText Typo="Typo.h6" Class="mb-2">@Localizer["Ranks4To10Heading"]</MudText>
        <MudList T="string" Dense="true" Class="mb-6">
            @foreach (var entry in _result.Ranking.Skip(3).Take(7))
            {
                <MudListItem T="string">#@entry.Rank @entry.Name (@Localizer["ComparisonsCountFormat", entry.ComparisonCount])</MudListItem>
            }
        </MudList>
    }

    @if (_result.Ranking.Count > 10)
    {
        <MudExpansionPanels>
            <MudExpansionPanel Text="@Localizer["MoreHeadingFormat", _result.Ranking.Count - 10]">
                <MudList T="string" Dense="true">
                    @foreach (var entry in _result.Ranking.Skip(10))
                    {
                        <MudListItem T="string">#@entry.Rank @entry.Name</MudListItem>
                    }
                </MudList>
            </MudExpansionPanel>
        </MudExpansionPanels>
    }
}

@code {
    [Parameter]
    public Guid RunId { get; set; }

    private RunResult? _result;
    private bool _finished;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _result = await RankingService.GetResultAsync(RunId);
            var step = await RankingService.GetNextStepAsync(RunId);
            _finished = step is RunFinishedStepView;
        }
        catch (Exception)
        {
            _error = Localizer["UnexpectedErrorMessage"];
        }
    }

    private static string MedalColor(int rank) => rank switch
    {
        1 => "#C9A227",
        2 => "#8C8C96",
        3 => "#A9673A",
        _ => "var(--mud-palette-primary)",
    };
}
