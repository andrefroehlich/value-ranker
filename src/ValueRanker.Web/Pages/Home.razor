@page "/"
@inject RankingService RankingService
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> Localizer

<PageTitle>@Localizer["AppTitle"]</PageTitle>

<MudText Typo="Typo.h3" Class="mb-4">@Localizer["AppTitle"]</MudText>

<MudPaper Class="pa-4 mb-6">
    <MudText Typo="Typo.h6" Class="mb-2">@Localizer["NewRunHeading"]</MudText>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudTextField @bind-Value="_newRunName" Label="@Localizer["NameLabel"]" Variant="Variant.Outlined" Class="flex-grow-1" Style="min-width:200px" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateRunAsync" Disabled="_busy">
            @Localizer["StartButton"]
        </MudButton>
    </MudStack>
</MudPaper>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}

@if (_runs is null)
{
    <MudText>@Localizer["LoadingText"]</MudText>
}
else if (_runs.Count == 0)
{
    <MudText>@Localizer["NoRunsText"]</MudText>
}
else
{
    @foreach (var run in _runs)
    {
        <MudPaper Class="pa-4 mb-2" Style="cursor:pointer" @onclick="() => Resume(run)">
            @if (_renamingRunId == run.Id)
            {
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" @onclick:stopPropagation="true">
                    <MudTextField @bind-Value="_renameValue" Variant="Variant.Outlined" AutoFocus="true" />
                    <MudButton Size="Size.Small" OnClick="() => ConfirmRenameAsync(run.Id)">@Localizer["SaveButton"]</MudButton>
                    <MudButton Size="Size.Small" OnClick="CancelRename">@Localizer["CancelButton"]</MudButton>
                </MudStack>
            }
            else
            {
                <MudText Typo="Typo.h6">@run.Name</MudText>
                <MudText Typo="Typo.body2">
                    @Localizer["RunSummaryFormat", PhaseLabel(run.Phase), run.CreatedAt.LocalDateTime.ToString("g"), run.UpdatedAt.LocalDateTime.ToString("g")]
                </MudText>
                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mt-2" @onclick:stopPropagation="true">
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => Resume(run)">@Localizer["ResumeButton"]</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => StartRename(run)">@Localizer["RenameButton"]</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="() => DeleteRunAsync(run.Id)">@Localizer["DeleteButton"]</MudButton>
                </MudStack>
            }
        </MudPaper>
    }
}

@code {
    private IReadOnlyList<RunSummary>? _runs;
    private string? _error;
    private bool _busy;
    private string _newRunName = DateTime.Now.ToString("g");
    private Guid? _renamingRunId;
    private string _renameValue = string.Empty;

    protected override Task OnInitializedAsync() => RefreshAsync();

    private async Task RefreshAsync()
    {
        try
        {
            _runs = await RankingService.ListRunsAsync();
        }
        catch (Exception)
        {
            _error = Localizer["UnexpectedErrorMessage"];
        }
    }

    private async Task CreateRunAsync()
    {
        if (string.IsNullOrWhiteSpace(_newRunName))
        {
            return;
        }

        _busy = true;
        _error = null;

        // The value list follows the current UI language; a run keeps its list even if the
        // language is changed later.
        var listId = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "en-default" : "de-default";

        try
        {
            var runId = await RankingService.CreateRunAsync(new CreateRunRequest(_newRunName, listId));
            Navigation.NavigateTo($"/run/{runId}");
        }
        catch (Exception)
        {
            _error = Localizer["UnexpectedErrorMessage"];
            _busy = false;
        }
    }

    private void Resume(RunSummary run)
    {
        Navigation.NavigateTo(run.Phase == RankingPhase.Finished ? $"/run/{run.Id}/result" : $"/run/{run.Id}");
    }

    private void StartRename(RunSummary run)
    {
        _renamingRunId = run.Id;
        _renameValue = run.Name;
    }

    private void CancelRename() => _renamingRunId = null;

    private async Task ConfirmRenameAsync(Guid runId)
    {
        if (!string.IsNullOrWhiteSpace(_renameValue))
        {
            await RankingService.RenameRunAsync(runId, _renameValue);
        }

        _renamingRunId = null;
        await RefreshAsync();
    }

    private async Task DeleteRunAsync(Guid runId)
    {
        await RankingService.DeleteRunAsync(runId);
        await RefreshAsync();
    }

    private string PhaseLabel(RankingPhase phase) => phase switch
    {
        RankingPhase.Build => Localizer["PhaseBuild"],
        RankingPhase.Focus => Localizer["PhaseFocus"],
        RankingPhase.Finale => Localizer["PhaseFinale"],
        RankingPhase.Finished => Localizer["PhaseFinished"],
        _ => phase.ToString(),
    };
}
