@page "/"
@inject RankingService RankingService
@inject NavigationManager Navigation

<PageTitle>ValueRanker</PageTitle>

<MudText Typo="Typo.h3" Class="mb-4">ValueRanker</MudText>

<MudPaper Class="pa-4 mb-6">
    <MudText Typo="Typo.h6" Class="mb-2">Neuer Lauf</MudText>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        <MudTextField @bind-Value="_newRunName" Label="Name" Variant="Variant.Outlined" />
        <MudSelect T="string" @bind-Value="_newRunListId" Label="Werteliste" Variant="Variant.Outlined">
            <MudSelectItem Value="@("de-default")">Deutsch</MudSelectItem>
            <MudSelectItem Value="@("en-default")">English</MudSelectItem>
        </MudSelect>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateRunAsync" Disabled="_busy">
            Starten
        </MudButton>
    </MudStack>
</MudPaper>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}

@if (_runs is null)
{
    <MudText>Lädt...</MudText>
}
else if (_runs.Count == 0)
{
    <MudText>Noch keine Läufe vorhanden.</MudText>
}
else
{
    @foreach (var run in _runs)
    {
        <MudPaper Class="pa-4 mb-2" Style="cursor:pointer" @onclick="() => Resume(run)">
            @if (_renamingRunId == run.Id)
            {
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" @onclick:stopPropagation="true">
                    <MudTextField @bind-Value="_renameValue" Variant="Variant.Outlined" AutoFocus="true" />
                    <MudButton Size="Size.Small" OnClick="() => ConfirmRenameAsync(run.Id)">Speichern</MudButton>
                    <MudButton Size="Size.Small" OnClick="CancelRename">Abbrechen</MudButton>
                </MudStack>
            }
            else
            {
                <MudText Typo="Typo.h6">@run.Name</MudText>
                <MudText Typo="Typo.body2">
                    Phase: @PhaseLabel(run.Phase) &middot; erstellt @run.CreatedAt.LocalDateTime.ToString("g") &middot; zuletzt geändert @run.UpdatedAt.LocalDateTime.ToString("g")
                </MudText>
                <MudStack Row="true" Spacing="1" Class="mt-2" @onclick:stopPropagation="true">
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => Resume(run)">Fortsetzen</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => StartRename(run)">Umbenennen</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="() => DeleteRunAsync(run.Id)">Löschen</MudButton>
                </MudStack>
            }
        </MudPaper>
    }
}

@code {
    private IReadOnlyList<RunSummary>? _runs;
    private string? _error;
    private bool _busy;
    private string _newRunName = DateTime.Now.ToString("g");
    private string _newRunListId = "de-default";
    private Guid? _renamingRunId;
    private string _renameValue = string.Empty;

    protected override Task OnInitializedAsync() => RefreshAsync();

    private async Task RefreshAsync()
    {
        try
        {
            _runs = await RankingService.ListRunsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task CreateRunAsync()
    {
        if (string.IsNullOrWhiteSpace(_newRunName))
        {
            return;
        }

        _busy = true;
        _error = null;

        try
        {
            var runId = await RankingService.CreateRunAsync(new CreateRunRequest(_newRunName, _newRunListId));
            Navigation.NavigateTo($"/run/{runId}");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _busy = false;
        }
    }

    private void Resume(RunSummary run)
    {
        Navigation.NavigateTo(run.Phase == RankingPhase.Finished ? $"/run/{run.Id}/result" : $"/run/{run.Id}");
    }

    private void StartRename(RunSummary run)
    {
        _renamingRunId = run.Id;
        _renameValue = run.Name;
    }

    private void CancelRename() => _renamingRunId = null;

    private async Task ConfirmRenameAsync(Guid runId)
    {
        if (!string.IsNullOrWhiteSpace(_renameValue))
        {
            await RankingService.RenameRunAsync(runId, _renameValue);
        }

        _renamingRunId = null;
        await RefreshAsync();
    }

    private async Task DeleteRunAsync(Guid runId)
    {
        await RankingService.DeleteRunAsync(runId);
        await RefreshAsync();
    }

    private static string PhaseLabel(RankingPhase phase) => phase switch
    {
        RankingPhase.Build => "Aufbau",
        RankingPhase.Focus => "Fokus",
        RankingPhase.Finale => "Finale",
        RankingPhase.Finished => "Abgeschlossen",
        _ => phase.ToString(),
    };
}
