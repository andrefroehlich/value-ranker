@page "/run/{RunId:guid}"
@inject RankingService RankingService
@inject NavigationManager Navigation

<PageTitle>ValueRanker</PageTitle>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}

@if (_step is null)
{
    <MudText>Lädt...</MudText>
}
else if (_step is RunFinishedStepView)
{
    <MudText>Fertig! Weiter zur <MudLink Href="@($"/run/{RunId}/result")">Ergebnisseite</MudLink>.</MudText>
}
else
{
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.subtitle1">Phase: @PhaseLabel() (Schätzung)</MudText>
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Outlined" OnClick="UndoAsync">Rückgängig</MudButton>
            <MudButton Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo($"/run/{RunId}/result"))">Ergebnis ansehen</MudButton>
        </MudStack>
    </MudStack>

    @if (_step is NextGroupStepView { TaskType: GroupTaskType.BestWorst } bestWorstGroup)
    {
        <MudText Class="mb-2">Tippe zuerst den wichtigsten, dann den unwichtigsten Wert an.</MudText>
        <MudGrid>
            @foreach (var value in bestWorstGroup.Values)
            {
                var background = value.Id == _selectedBestId ? "var(--mud-palette-success)"
                    : value.Id == _selectedWorstId ? "var(--mud-palette-error)"
                    : "var(--mud-palette-surface)";

                <MudItem xs="12" sm="6">
                    <MudPaper Class="pa-4" Style="@($"cursor:pointer; min-height:120px; background-color:{background}")" Outlined="true" @onclick="@(() => TapBestWorst(value.Id))">
                        <MudText Typo="Typo.h6">@value.Name</MudText>
                        <MudText Typo="Typo.body2">@value.Description</MudText>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }
    else if (_step is NextGroupStepView fullOrderGroup)
    {
        <MudText Class="mb-2">Tippe die Werte in der Reihenfolge vom wichtigsten zum unwichtigsten an (der letzte ergibt sich von selbst).</MudText>
        <MudGrid>
            @foreach (var value in fullOrderGroup.Values)
            {
                var position = _order.IndexOf(value.Id);
                var background = position >= 0 ? "var(--mud-palette-primary-lighten)" : "var(--mud-palette-surface)";

                <MudItem xs="12" sm="6">
                    <MudPaper Class="pa-4" Style="@($"cursor:pointer; min-height:120px; background-color:{background}")" Outlined="true" @onclick="@(() => TapFullOrder(value.Id, fullOrderGroup.Values.Count))">
                        @if (position >= 0)
                        {
                            <MudText Typo="Typo.caption">Platz @(position + 1)</MudText>
                        }
                        <MudText Typo="Typo.h6">@value.Name</MudText>
                        <MudText Typo="Typo.body2">@value.Description</MudText>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }
    else if (_step is NextDuelStepView duel)
    {
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudPaper Class="pa-6" Style="cursor:pointer; min-height:160px" Outlined="true" @onclick="@(() => SubmitDuelAsync(DuelResult.Left))">
                    <MudText Typo="Typo.h5">@duel.Left.Name</MudText>
                    <MudText Typo="Typo.body2">@duel.Left.Description</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudPaper Class="pa-6" Style="cursor:pointer; min-height:160px" Outlined="true" @onclick="@(() => SubmitDuelAsync(DuelResult.Right))">
                    <MudText Typo="Typo.h5">@duel.Right.Name</MudText>
                    <MudText Typo="Typo.body2">@duel.Right.Description</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
        <MudButton Class="mt-4" Variant="Variant.Outlined" OnClick="@(() => SubmitDuelAsync(DuelResult.Equal))">
            Beide gleich wichtig
        </MudButton>
    }
}

@code {
    [Parameter]
    public Guid RunId { get; set; }

    private NextStepView? _step;
    private string? _error;
    private string? _selectedBestId;
    private string? _selectedWorstId;
    private readonly List<string> _order = [];

    protected override Task OnParametersSetAsync() => LoadStepAsync();

    private async Task LoadStepAsync()
    {
        _selectedBestId = null;
        _selectedWorstId = null;
        _order.Clear();

        try
        {
            _step = await RankingService.GetNextStepAsync(RunId);

            if (_step is RunFinishedStepView)
            {
                Navigation.NavigateTo($"/run/{RunId}/result");
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private Task TapBestWorst(string valueId)
    {
        if (_selectedBestId == valueId)
        {
            _selectedBestId = null;
            return Task.CompletedTask;
        }

        if (_selectedWorstId == valueId)
        {
            _selectedWorstId = null;
            return Task.CompletedTask;
        }

        if (_selectedBestId is null)
        {
            _selectedBestId = valueId;
            return Task.CompletedTask;
        }

        _selectedWorstId = valueId;
        return SubmitBestWorstAsync(((NextGroupStepView)_step!).Values.Select(v => v.Id).ToList(), _selectedBestId, _selectedWorstId);
    }

    private async Task SubmitBestWorstAsync(IReadOnlyList<string> valueIds, string bestId, string worstId)
    {
        try
        {
            await RankingService.SubmitGroupBestWorstAsync(RunId, new GroupBestWorstAnswer(valueIds, bestId, worstId));
            await LoadStepAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private Task TapFullOrder(string valueId, int groupSize)
    {
        if (_order.Remove(valueId))
        {
            return Task.CompletedTask;
        }

        _order.Add(valueId);

        if (_order.Count == groupSize - 1)
        {
            var group = (NextGroupStepView)_step!;
            var lastId = group.Values.Select(v => v.Id).First(id => !_order.Contains(id));
            _order.Add(lastId);
            return SubmitFullOrderAsync([.. _order]);
        }

        return Task.CompletedTask;
    }

    private async Task SubmitFullOrderAsync(IReadOnlyList<string> orderedValueIds)
    {
        try
        {
            await RankingService.SubmitGroupFullOrderAsync(RunId, new GroupFullOrderAnswer(orderedValueIds));
            await LoadStepAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task SubmitDuelAsync(DuelResult result)
    {
        try
        {
            var duel = (NextDuelStepView)_step!;
            await RankingService.SubmitDuelAsync(RunId, new DuelAnswer(duel.Left.Id, duel.Right.Id, result));
            await LoadStepAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task UndoAsync()
    {
        try
        {
            await RankingService.UndoAsync(RunId);
            await LoadStepAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private string PhaseLabel() => _step switch
    {
        NextGroupStepView { TaskType: GroupTaskType.BestWorst } => "Aufbau",
        NextGroupStepView => "Fokus",
        NextDuelStepView => "Finale",
        _ => string.Empty,
    };
}
