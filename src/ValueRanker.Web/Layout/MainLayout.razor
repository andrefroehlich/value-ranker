@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> Localizer

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6">ValueRanker</MudText>
        <MudSpacer />
        <MudButton Variant="@(IsCurrent("de") ? Variant.Filled : Variant.Text)" Color="Color.Inherit" OnClick="@(() => SetCultureAsync("de"))">DE</MudButton>
        <MudButton Variant="@(IsCurrent("en") ? Variant.Filled : Variant.Text)" Color="Color.Inherit" OnClick="@(() => SetCultureAsync("en"))">EN</MudButton>
    </MudAppBar>
    <MudMainContent>
        <MudContainer Class="pa-4" MaxWidth="MaxWidth.Large">
            <ErrorBoundary>
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="exception">
                    <MudAlert Severity="Severity.Error" Class="my-4">
                        <MudText Typo="Typo.h6">@Localizer["UnexpectedErrorHeading"]</MudText>
                        <MudText>@Localizer["UnexpectedErrorMessage"]</MudText>
                        <MudButton Class="mt-2" Variant="Variant.Outlined" OnClick="@(() => Navigation.NavigateTo(Navigation.Uri, forceLoad: true))">
                            @Localizer["ReloadButton"]
                        </MudButton>
                    </MudAlert>
                </ErrorContent>
            </ErrorBoundary>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool IsCurrent(string culture) => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == culture;

    private async Task SetCultureAsync(string culture)
    {
        if (IsCurrent(culture))
        {
            return;
        }

        await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/blazorCulture.js");
        await module.InvokeVoidAsync("setCulture", culture);
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }
}
